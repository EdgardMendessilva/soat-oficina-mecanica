# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o Git.
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=defina-uma-senha-aqui
JWT_SECRET=defina-um-segredo-longo-aqui

# Usuários de demonstração (um de cada perfil, senha Teste@1234). Em produção, use false.
SEED_DEMO=true
# Primeiro Administrador (RN14), opcional
ADMIN_DOCUMENTO=
ADMIN_SENHA=
