{
 "openapi": "3.0.3",
 "info": {
  "title": "Sistema Integrado da Oficina Mecânica",
  "version": "1.0.0",
  "description": "MVP back-end do Tech Challenge Fase 1 (SOAT). Valores em centavos. Faça login em /auth/login e use o token em Authorize."
 },
 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "JWT"
   }
  },
  "schemas": {
   "Erro": {
    "type": "object",
    "properties": {
     "erro": {
      "type": "object",
      "properties": {
       "codigo": {
        "type": "string"
       },
       "mensagem": {
        "type": "string"
       }
      }
     }
    }
   },
   "OrdemDeServico": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "clienteId": {
      "type": "string"
     },
     "veiculoId": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "Recebida",
       "Em diagnóstico",
       "Aguardando aprovação",
       "Em execução",
       "Finalizada",
       "Entregue"
      ]
     },
     "decisao": {
      "type": "string",
      "enum": [
       "Pendente",
       "Aprovado",
       "Reprovado"
      ]
     },
     "valorDoOrcamentoCentavos": {
      "type": "integer"
     },
     "maoDeObraCentavos": {
      "type": "integer"
     },
     "totalCentavos": {
      "type": "integer"
     },
     "valorAPagarCentavos": {
      "type": "integer"
     },
     "servicos": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "pecas": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "desconto": {
      "type": "object"
     },
     "historico": {
      "type": "array",
      "items": {
       "type": "object"
      }
     }
    }
   }
  }
 },
 "paths": {
  "/health": {
   "get": {
    "summary": "Verifica se a API está no ar",
    "responses": {
     "200": {
      "description": "ok"
     }
    }
   }
  },
  "/auth/login": {
   "post": {
    "summary": "Login por CPF + senha (RN11)",
    "description": "Devolve o token JWT para usar em Authorize.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "documento": {
          "type": "string",
          "example": "111.444.777-35"
         },
         "senha": {
          "type": "string",
          "example": "Teste@1234"
         }
        },
        "required": [
         "documento",
         "senha"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Token emitido"
     },
     "401": {
      "description": "CPF ou senha inválidos",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     },
     "400": {
      "description": "JSON inválido",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     }
    }
   }
  },
  "/ordens": {
   "post": {
    "summary": "Abre uma OS (status Recebida)",
    "description": "Perfis: Atendente, Gerente, Administrador. O veículo precisa existir e pertencer ao cliente.",
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "responses": {
     "201": {
      "description": "OS criada",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OrdemDeServico"
        }
       }
      }
     },
     "401": {
      "description": "Não autenticado",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     },
     "403": {
      "description": "Acesso negado",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     },
     "422": {
      "description": "Dados inválidos",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "clienteId": {
          "type": "string"
         },
         "veiculoId": {
          "type": "string"
         },
         "valorDoOrcamentoCentavos": {
          "type": "integer"
         }
        },
        "required": [
         "clienteId",
         "veiculoId",
         "valorDoOrcamentoCentavos"
        ]
       }
      }
     }
    }
   },
   "get": {
    "summary": "Lista as OS (o cliente só vê as próprias, RN10)",
    "description": "Perfis: qualquer usuário autenticado",
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "responses": {
     "200": {
      "description": "Lista",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/OrdemDeServico"
         }
        }
       }
      }
     },
     "401": {
      "description": "Não autenticado",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     }
    }
   }
  },
